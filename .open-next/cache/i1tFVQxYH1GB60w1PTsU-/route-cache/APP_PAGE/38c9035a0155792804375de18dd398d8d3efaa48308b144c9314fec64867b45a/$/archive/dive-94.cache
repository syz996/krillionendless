:[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hint:\\\"}],\\\" \\\",\\\"A 'station' goes well beyond trains. Think about the places people work out of, the spots that keep city services running, and the platforms that broadcast or transmit. Many of these answers are everyday words that simply never get called to mind under time pressure.\\\"]}]]}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Name a country whose name ends in the letter E\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"prompt-hint\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hint:\\\"}],\\\" \\\",\\\"The letter E is a common country-name ending across several continents. Start with the big European names, then push into Africa, the Americas and island nations — the less obvious geography is where the highest-value answers tend to sit.\\\"]}]]}],\\\"$Lf\\\"]}]]}],\\\"$L10\\\",\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\"]}],\\\"$L14\\\"]\\n\"])</script><script>self.__next_f.push([1,\"f:[\\\"$\\\",\\\"li\\\",\\\"6\\\",{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Name a superhero team\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"prompt-hint\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hint:\\\"}],\\\" \\\",\\\"Look beyond the two or three most famous movie teams. Comic book history is full of superteams across the big universes and beyond. A strong pick is one most casual fans recognise but rarely think to name first.\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"10:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"What made this dive hard\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"This dive leans hard into open-ended listing questions. Almost every prompt accepts dozens of valid answers, which means the scoring gap between a common pick and a rare one is far larger than the gap between knowing something and knowing nothing. Speed matters, but choosing a memorable angle matters more.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"A few prompts quietly test recall rather than creativity. The one-letter chemical symbols form a short, fixed list, and the four-letter animal question rewards scanning a broad mental list instead of stopping early. These are the rounds where a fast, systematic sweep beats the first thing that comes to mind.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"The sports-honour question is the widest net on the page: it crosses American leagues and the biggest individual prize in football, so both casual and die-hard fans can play. The superhero and station prompts are the friendly entry points, while geography and food anchor the middle of the pack.\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"11:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"ad-slot\\\",\\\"children\\\":\\\"Advertisement\\\"}]\\n12:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"Other dives\\\"}],[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"pager\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{}],[\\\"$\\\",\\\"span\\\",null,{}]]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"archive\\\",\\\"children\\\":[]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"FAQ\\\"}],[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"open\\\":true,\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"Is this the official Krillion archive?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"No. This is an independent, fan-made archive — not affiliated with the official game at krillion.io.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"open\\\":false,\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"Do these pa